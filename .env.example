# ==== AutoContentPipeline environment variables ====
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Set DRY_RUN=1 to mock ALL external APIs (no keys needed, nothing published, no credits spent).
# Set DRY_RUN=0 (or remove) to hit real services.
DRY_RUN=1

# --- OpenAI (content + prompt translation) ---
OPENAI_API_KEY=

# --- Replicate (Flux 1.1 Pro image generation) ---
REPLICATE_API_TOKEN=

# --- Publish target: "wordpress" (default) or "corevmax" ---
PUBLISH_TARGET=wordpress

# --- WordPress REST API (used when PUBLISH_TARGET=wordpress) ---
# Base site URL, e.g. https://example.com  (no trailing slash)
WP_BASE_URL=
WP_USER=
# WordPress Application Password (Users -> Profile -> Application Passwords)
WP_APP_PASSWORD=

# --- CoreVMax Publishing API (used when PUBLISH_TARGET=corevmax) ---
# Base site URL, e.g. https://example.com  (no trailing slash)
CVX_BASE_URL=
# Value of PUBLISHING_API_TOKEN in the CoreVMax site's own .env
CVX_API_TOKEN=
